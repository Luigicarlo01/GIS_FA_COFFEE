  )

  if (
    is.finite(total.interaction) &&
      total.interaction > 0
  ) {
    tabela.pares <- tabela.pares %>%
      mutate(
        prop_interaction =
          mean_abs_SHAP_interaction / total.interaction,
        prop_interaction_acumulado =
          cumsum(prop_interaction)
      )
  } else {

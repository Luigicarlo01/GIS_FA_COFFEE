  }

  saveRDS(
    interaction.array,
    file.path(
      pasta.rds,
      paste0(
        "SHAP_Interaction_array_",
        make.names(fator),
        ".RDS"
      )
    )
  )

  #-------------------------------------------------------------------------
  # 8.4 MATRIZ MEDIA ABSOLUTA DAS INTERACOES
  #-------------------------------------------------------------------------

  mean.interaction <- apply(
    abs(interaction.array),
    MARGIN = c(2, 3),
    FUN = mean,
    na.rm = TRUE
  )

  rownames(mean.interaction) <- colnames(X.fit)
  colnames(mean.interaction) <- colnames(X.fit)


  )

  pares.interaction[[fator]] <- pares.final
  features.interaction[[fator]] <- vars.interaction.adicionadas
  features.final.por.fator[[fator]] <- vars.final.fator
  modelos.finais[[fator]] <- modelo.final.fator

  #-------------------------------------------------------------------------
  # 8.7 SALVAR RESULTADOS DO FATOR
  #-------------------------------------------------------------------------

  write.csv(
    grid.resultado,
    file.path(
      pasta.tabelas,
      paste0(
        "Grid_SHAP_Interaction_",

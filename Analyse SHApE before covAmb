    )

    chave <- as.character(
      n.pares
    )

    modelos.grid[[chave]] <- modelo.candidato
    features.grid[[chave]] <- vars.candidato

    grid.resultado <- bind_rows(
      grid.resultado,
      data.frame(
        n_pares = n.pares,
        n_features_SHAP = length(vars.shap),
        n_features_interaction = length(vars.interaction.candidato),
        n_features_finais = length(vars.candidato),
        RMSE_valid = rmse.candidato,
        stringsAsFactors = FALSE
      )
    )
  }

  grid.resultado <- grid.resultado %>%
    arrange(
      RMSE_valid,
      n_features_finais,
      n_pares
    )

  melhor.n.pares <- grid.resultado$n_pares[1]
  chave.melhor <- as.character(melhor.n.pares)

  vars.final.fator <- features.grid[[chave.melhor]]
  modelo.final.fator <- modelos.grid[[chave.melhor]]

  if (melhor.n.pares == 0) {
    pares.final <- tabela.pares[
      0,

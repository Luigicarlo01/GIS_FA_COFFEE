  rmse.completo <- rmse(
    y.valid,
    pred.valid.completo
  )

  #-------------------------------------------------------------------------
  # 8.2 SHAP PRINCIPAL
  #-------------------------------------------------------------------------

  shap.raw <- catboost.get_feature_importance(
    model = modelo.completo,
    pool = pool.fit,
    type = "ShapValues"
  )

  shap.features <- shap.raw[
    ,
    seq_len(ncol(X.fit)),
    drop = FALSE
  ]

  colnames(shap.features) <- colnames(X.fit)

  mean.abs.shap <- colMeans(
    abs(shap.features),
    na.rm = TRUE
  )

  ranking <- data.frame(
    feature = names(mean.abs.shap),
    mean_abs_SHAP = as.numeric(mean.abs.shap),
    stringsAsFactors = FALSE
  ) %>%
    arrange(
      desc(mean_abs_SHAP)
    )

  total.shap <- sum(
    ranking$mean_abs_SHAP,
    na.rm = TRUE
  )

  if (is.finite(total.shap) && total.shap > 0) {
    ranking <- ranking %>%
      mutate(
        prop_SHAP = mean_abs_SHAP / total.shap,
        prop_SHAP_acumulado = cumsum(prop_SHAP)
      )
  } else {
    ranking$prop_SHAP <- 0
    ranking$prop_SHAP_acumulado <- 0
  }

  ranking.shap[[fator]] <- ranking

  vars.shap <- seleciona.shap(
    ranking = ranking,
    prop = prop.shap,
    min.features = min.features
  )

  features.shap[[fator]] <- vars.shap

  cat(
    "Features SHAP principal:",
    length(vars.shap),
    "\n"
  )

  print(vars.shap)

  write.csv(
    ranking,
    file.path(
      pasta.tabelas,
      paste0(
        "Ranking_SHAP_",
        make.names(fator),
        ".csv"
      )
    ),
    row.names = FALSE
  )

  #-------------------------------------------------------------------------
  # 8.3 SALVAR MODELO COMPLETO E ABRIR NO PYTHON
  #-------------------------------------------------------------------------

  arquivo.modelo <- file.path(
    pasta.modelos,
    paste0(
      "CatBoost_completo_",
      make.names(fator),
      ".cbm"
    )
  )

  catboost.save_model(
    modelo.completo,
    arquivo.modelo
  )

  arquivo.modelo <- normalizePath(
    arquivo.modelo,
    mustWork = TRUE
  )

  modelo.py <- catboost_py$CatBoostRegressor()

  modelo.py$load_model(
    arquivo.modelo
  )

  X.fit.matrix <- as.matrix(
    X.fit
  )

  storage.mode(
    X.fit.matrix
  ) <- "double"

  X.fit.py <- r_to_py(
    X.fit.matrix,
    convert = FALSE
  )

  explainer.py <- shap_py$TreeExplainer(
    modelo.py
  )

  cat(
    "Calculando SHAP Interaction para",
    fator,
    "...\n"
  )

  tempo.interaction <- system.time({
    interaction.py <- explainer.py$shap_interaction_values(
      X.fit.py
    )
  })

  print(
    tempo.interaction
  )

  interaction.array <- py_to_r(
    interaction.py
  )

  dims <- dim(
    interaction.array
  )

  if (
    length(dims) != 3 ||
      dims[1] != nrow(X.fit) ||
      dims[2] != ncol(X.fit) ||
      dims[3] != ncol(X.fit)
  ) {

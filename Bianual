  rbind,
  lapply(envs, get_blue_env, data = data2)
)

n_env <- nrow(CovAmb)


if (n_env < 3) {
  stop("Número insuficiente de ambientes para validação.")
}

nmax <- min(30, n_env - 2, ncol(CovAmb))

cv.results <- do.call(rbind, lapply(1:nmax, function(j) {
  
  acc_lambda <- numeric(0)
  acc_blue   <- numeric(0)
  rmsep_blue <- numeric(0)
  
  for (i in rownames(CovAmb)) {
    
    env_train <- setdiff(rownames(CovAmb), i)
    
    df_train <- data.frame(
      lambda = I(Lambda[env_train, , drop = FALSE]),
      CovAmb = I(CovAmb[env_train, , drop = FALSE])
    )
    
    mod_pls <- pls::plsr(
      lambda ~ CovAmb,
      data = df_train,
      ncomp = j,
      validation = "none"
    )
    
    cf <- coef(mod_pls, ncomp = j, intercept = TRUE)[, , 1]
    
    B  <- as.matrix(cf[-1, , drop = FALSE])
    b0 <- matrix(as.numeric(cf[1, ]), nrow = 1)
    
    pred_l <- CovAmb[i, , drop = FALSE] %*% B + b0
    
    acc_lambda <- c(
      acc_lambda,
      suppressWarnings(
        cor(as.numeric(pred_l), as.numeric(Lambda[i, ]))
      )
    )
    
    pred_e <- as.numeric(pred_l %*% t(fa4$rot.scores))
    names(pred_e) <- rownames(fa4$rot.scores)
    
    
    obs_tab <- blue_tab[blue_tab$env == i, c("gen", "blue_dev")]
    
    common_gen <- intersect(names(pred_e), obs_tab$gen)
    
    pred_use <- pred_e[common_gen]
    obs_use  <- obs_tab$blue_dev[match(common_gen, obs_tab$gen)]
    
    valid <- is.finite(pred_use) & is.finite(obs_use)
    
    pred_use <- pred_use[valid]
    obs_use  <- obs_use[valid]
    
    if (length(pred_use) >= 3) {
      
      acc_blue <- c(
        acc_blue,
        suppressWarnings(
          cor(pred_use, obs_use, method = "spearman")
        )
      )
      
      rmsep_blue <- c(
        rmsep_blue,
        sqrt(mean((pred_use - obs_use)^2, na.rm = TRUE))
      )
    }
  }
  
  
  data.frame(
    ncomp         = j,
    lambda_cor    = mean(acc_lambda, na.rm = TRUE),
    blue_spearman = mean(acc_blue, na.rm = TRUE),
    blue_rmsep    = mean(rmsep_blue, na.rm = TRUE)
  )
}))


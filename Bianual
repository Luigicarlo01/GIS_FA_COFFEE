# Organizando os dados ambientais ---------
# Calculando para as janelas de 15 dias, no caso dos ambientes calculado com media de dois anos, os dados ambientais sao 
#   as medias dos 15 dias do primeiro ano e dos 15 dias do segundo ano
library(stringr)
library(lubridate)
library(dplyr)
library(tidyr)

env.info <- env.info %>%
  dplyr::mutate(
    data = as.Date(YYYYMMDD),
    ano_janela = ifelse(month(data) >= 8, year(data) + 1, year(data)),
    inicio_ciclo = as.Date(paste0(ano_janela - 1, "-08-01")),
    dia_ciclo = as.numeric(data - inicio_ciclo) + 1,
    periodo = ceiling(dia_ciclo / 15)
  )


env.list <- list()

for (i in 1:length(unique(data2$env))) {
  
  dt <- data2 %>%
    dplyr::filter(env %in% levels(droplevels(data2$env))[i]) %>%
    dplyr::select(lat, lon, ano, env) %>%
    distinct()
  
  anos <- as.numeric(unlist(str_split(dt$ano, "-")))
  
  env.frac <- env.info %>%
    dplyr::select(-data, -inicio_ciclo, -dia_ciclo, -DOY, -YYYYMMDD) %>%
    semi_join(dt, by = c("lat", "lon")) %>%
    dplyr::filter(ano_janela %in% anos) %>%
    dplyr::select(-ano_janela) %>%
    # agrupa por PERIODO, nao por ano -> se o env tiver 2 anos-safra,
    # os dias do mesmo periodo nos dois anos entram na mesma media,
    # e cada periodo vira uma variavel nova apos o pivot_wider
    group_by(lat, lon, periodo) %>%
    summarise(
      across(where(is.numeric), \(x) mean(x, na.rm = TRUE)),
      .groups = "drop"
    ) %>%
    pivot_wider(
      names_from = periodo,
      values_from = -c(lat, lon, periodo),
      names_glue = "{.value}.m{periodo}"
    )
  
  env.frac$env <- levels(droplevels(data2$env))[i]
  ordem <- c("env", setdiff(colnames(env.frac), "env"))
  env.frac <- env.frac[, ordem]
  
  env.list[[length(env.list) + 1]] <- env.frac
}

env.final <- dplyr::bind_rows(env.list)


get_blue_env <- function(env_i, data) {
  
  df_i <- data[data$env == env_i, ]
  df_i <- droplevels(df_i)
  
  out<- df_i%>%dplyr::group_by(gen)%>%
    dplyr::summarise(blue=mean(prod,na.rm=T))%>%
    dplyr::mutate(env=env_i)
  
  out$blue_dev <- out$blue - mean(out$blue, na.rm = TRUE)
  out
}



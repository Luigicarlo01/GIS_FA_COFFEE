rmse <- function(observado, predito) {
  sqrt(mean((observado - predito)^2, na.rm = TRUE))
}

seleciona.shap <- function(ranking, prop = 0.90, min.features = 5) {
  
  ranking <- ranking %>%
    arrange(desc(mean_abs_SHAP))
  
  total <- sum(ranking$mean_abs_SHAP, na.rm = TRUE)
  
  if (!is.finite(total) || total <= 0) {
    n.sel <- min(min.features, nrow(ranking))
    return(ranking$feature[seq_len(n.sel)])
  }
  
  ranking <- ranking %>%
    mutate(
      prop_SHAP = mean_abs_SHAP / total,
      prop_SHAP_acumulado = cumsum(prop_SHAP)
    )
  
  n.prop <- which(ranking$prop_SHAP_acumulado >= prop)[1]
  n.sel <- max(min.features, n.prop)
  n.sel <- min(n.sel, nrow(ranking))
  
  ranking$feature[seq_len(n.sel)]
}


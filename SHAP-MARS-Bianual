# 8. LOOP: UM CATBOOST PARA CADA CARGA FATORIAL
#-------------------------------------------------------------------------------

for (j in seq_len(ncol(Lambda))) {
  
  fator <- colnames(Lambda)[j]
  
  cat("\n============================================================\n")
  cat("FATOR:", fator, "\n")
  cat("============================================================\n\n")
  
  y <- as.numeric(Lambda[, j])
  
  # CatBoost nao precisa de padronizacao.
  X <- as.data.frame(CovAmb0)
  
  X.fit <- X[id.fit, , drop = FALSE]
  X.valid <- X[id.valid, , drop = FALSE]
  
  y.fit <- y[id.fit]
  y.valid <- y[id.valid]
  
  #-------------------------------------------------------------------------
  # 8.1 CATBOOST COMPLETO
  #-------------------------------------------------------------------------
  
  pool.fit <- catboost.load_pool(
    data = X.fit,
    label = y.fit
  )
  
  pool.valid <- catboost.load_pool(
    data = X.valid,
    label = y.valid
  )
  
  modelo.completo <- catboost.train(
    learn_pool = pool.fit,
    test_pool = pool.valid,
    params = params.catboost
  )
  
  modelos.catboost[[fator]] <- modelo.completo
  
  pred.valid.completo <- catboost.predict(
    modelo.completo,
    pool.valid
  )
  
  rmse.completo <- rmse(
    y.valid,
    pred.valid.completo
  )
  
  #-------------------------------------------------------------------------
  # 8.2 SHAP PRINCIPAL
  #-------------------------------------------------------------------------
  
  shap.raw <- catboost.get_feature_importance(
    model = modelo.completo,
    pool = pool.fit,
    type = "ShapValues"
  )
  
  # A ultima coluna de ShapValues e o expected/base value.
  shap.features <- shap.raw[
    ,
    seq_len(ncol(X.fit)),
    drop = FALSE
  ]
  
  colnames(shap.features) <- colnames(X.fit)
  
  mean.abs.shap <- colMeans(
    abs(shap.features),
    na.rm = TRUE
  )
  
  ranking <- data.frame(
    feature = names(mean.abs.shap),
    mean_abs_SHAP = as.numeric(mean.abs.shap),
    stringsAsFactors = FALSE
  ) %>%
    arrange(desc(mean_abs_SHAP))
  
  total.shap <- sum(ranking$mean_abs_SHAP, na.rm = TRUE)
  
  if (is.finite(total.shap) && total.shap > 0) {
    ranking <- ranking %>%
      mutate(
        prop_SHAP = mean_abs_SHAP / total.shap,
        prop_SHAP_acumulado = cumsum(prop_SHAP)
      )
  } else {
    ranking$prop_SHAP <- 0
    ranking$prop_SHAP_acumulado <- 0
  }
  
  ranking.shap[[fator]] <- ranking
  
  vars.shap <- seleciona.shap(
    ranking = ranking,
    prop = prop.shap,
    min.features = min.features
  )
  
  features.shap[[fator]] <- vars.shap
  
  cat("Features SHAP principal:", length(vars.shap), "\n")
  print(vars.shap)
  
  write.csv(
    ranking,
    file.path(
      pasta.tabelas,
      paste0("Ranking_SHAP_", make.names(fator), ".csv")
    ),
    row.names = FALSE
  )
  
  #-------------------------------------------------------------------------
  # 8.3 SALVAR MODELO E CARREGAR NO PYTHON
  #-------------------------------------------------------------------------
  
  arquivo.modelo <- file.path(
    pasta.modelos,
    paste0("CatBoost_completo_", make.names(fator), ".cbm")
  )
  
  catboost.save_model(
    modelo.completo,
    arquivo.modelo
  )
  
  arquivo.modelo <- normalizePath(
    arquivo.modelo,
    mustWork = TRUE
  )
  
  modelo.py <- catboost_py$CatBoostRegressor()
  modelo.py$load_model(arquivo.modelo)
  
  X.fit.matrix <- as.matrix(X.fit)
  storage.mode(X.fit.matrix) <- "double"
  
  X.fit.py <- r_to_py(
    X.fit.matrix,
    convert = FALSE
  )
  
  explainer.py <- shap_py$TreeExplainer(
    modelo.py
  )
  
  cat("Calculando SHAP Interaction para", fator, "...\n")
  
  tempo.interaction <- system.time({
    interaction.py <- explainer.py$shap_interaction_values(
      X.fit.py
    )
  })
  
  print(tempo.interaction)
  
  interaction.array <- py_to_r(
    interaction.py
  )
  
  dims <- dim(interaction.array)
  
  if (
    length(dims) != 3 ||
    dims[1] != nrow(X.fit) ||
    dims[2] != ncol(X.fit) ||
    dims[3] != ncol(X.fit)
  ) {
    stop(
      paste(
        "Dimensoes inesperadas do SHAP Interaction para",
        fator,
        ":",
        paste(dims, collapse = " x ")
      )
    )
  }
  
  saveRDS(
    interaction.array,
    file.path(
      pasta.rds,
      paste0("SHAP_Interaction_array_", make.names(fator), ".RDS")
    )
  )
  
  #-------------------------------------------------------------------------
  # 8.4 MATRIZ MEDIA ABSOLUTA DAS INTERACOES
  #-------------------------------------------------------------------------
  
  mean.interaction <- apply(
    abs(interaction.array),
    MARGIN = c(2, 3),
    FUN = mean,
    na.rm = TRUE
  )
  
  rownames(mean.interaction) <- colnames(X.fit)
  colnames(mean.interaction) <- colnames(X.fit)
  
  matrizes.interaction[[fator]] <- mean.interaction
  
  saveRDS(
    mean.interaction,
    file.path(
      pasta.rds,
      paste0("Matriz_SHAP_Interaction_", make.names(fator), ".RDS")
    )
  )
  
  write.csv(
    mean.interaction,
    file.path(
      pasta.tabelas,
      paste0("Matriz_SHAP_Interaction_", make.names(fator), ".csv")
    ),
    row.names = TRUE
  )
  
  #-------------------------------------------------------------------------
  # 8.5 RANKING DOS PARES
  #-------------------------------------------------------------------------
  
  matriz.pares <- mean.interaction
  
  # A diagonal corresponde aos efeitos principais.
  diag(matriz.pares) <- NA_real_
  
  posicoes <- which(
    upper.tri(
      matriz.pares,
      diag = FALSE
    ),
    arr.ind = TRUE
  )
  
  tabela.pares <- data.frame(
    feature_1 = rownames(matriz.pares)[posicoes[, 1]],
    feature_2 = colnames(matriz.pares)[posicoes[, 2]],
    mean_abs_SHAP_interaction = matriz.pares[posicoes],
    stringsAsFactors = FALSE
  ) %>%
    filter(is.finite(mean_abs_SHAP_interaction)) %>%
    arrange(desc(mean_abs_SHAP_interaction))
  
  total.interaction <- sum(
    tabela.pares$mean_abs_SHAP_interaction,
    na.rm = TRUE
  )
  
  if (is.finite(total.interaction) && total.interaction > 0) {
    tabela.pares <- tabela.pares %>%
      mutate(
        prop_interaction =
          mean_abs_SHAP_interaction / total.interaction,
        prop_interaction_acumulado =
          cumsum(prop_interaction)
      )
  } else {
    tabela.pares$prop_interaction <- 0
    tabela.pares$prop_interaction_acumulado <- 0
  }
  
  ranking.interaction[[fator]] <- tabela.pares
  
  write.csv(
    tabela.pares,
    file.path(
      pasta.tabelas,
      paste0("Ranking_SHAP_Interaction_", make.names(fator), ".csv")
    ),
    row.names = FALSE
  )
  
  cat("\nTop 20 pares SHAP Interaction:\n")
  print(head(tabela.pares, 20))
  
  #-------------------------------------------------------------------------
  # 8.6 TESTAR QUANTOS PARES ADICIONAR
  #-------------------------------------------------------------------------
  
  grid.resultado <- data.frame()
  modelos.grid <- list()
  features.grid <- list()
  
  grid.usado <- sort(
    unique(
      pmin(
        grid.top.pares.interaction,
        nrow(tabela.pares)
      )
    )
  )
  
  for (n.pares in grid.usado) {
    
    if (n.pares == 0) {
      
      pares.candidato <- tabela.pares[
        0,
        ,
        drop = FALSE
      ]
      
      vars.interaction.candidato <- character(0)
      
    } else {
      
      pares.candidato <- head(
        tabela.pares,
        n.pares
      )
      
      vars.interaction.candidato <- unique(
        c(
          pares.candidato$feature_1,
          pares.candidato$feature_2
        )
      )
    }
    
    # Conjunto candidato =
    # SHAP principal + variaveis envolvidas nos melhores pares.
    vars.candidato <- unique(
      c(
        vars.shap,
        vars.interaction.candidato
      )
    )
    
    X.fit.candidato <- X.fit[
      ,
      vars.candidato,
      drop = FALSE
    ]
    
    X.valid.candidato <- X.valid[
      ,
      vars.candidato,
      drop = FALSE
    ]
    
    pool.fit.candidato <- catboost.load_pool(
      data = X.fit.candidato,
      label = y.fit
    )
    
    pool.valid.candidato <- catboost.load_pool(
      data = X.valid.candidato,
      label = y.valid
    )
    
    modelo.candidato <- catboost.train(
      learn_pool = pool.fit.candidato,
      test_pool = pool.valid.candidato,
      params = params.catboost
    )
    
    pred.valid.candidato <- catboost.predict(
      modelo.candidato,
      pool.valid.candidato
    )
    
    rmse.candidato <- rmse(
      y.valid,
      pred.valid.candidato
    )
    
    chave <- as.character(n.pares)
    
    modelos.grid[[chave]] <- modelo.candidato
    features.grid[[chave]] <- vars.candidato
    
    grid.resultado <- bind_rows(
      grid.resultado,
      data.frame(
        n_pares = n.pares,
        n_features_SHAP = length(vars.shap),
        n_features_interaction =
          length(vars.interaction.candidato),
        n_features_finais = length(vars.candidato),
        RMSE_valid = rmse.candidato,
        stringsAsFactors = FALSE
      )
    )
  }
  
  grid.resultado <- grid.resultado %>%
    arrange(
      RMSE_valid,
      n_features_finais,
      n_pares
    )
  
  melhor.n.pares <- grid.resultado$n_pares[1]
  chave.melhor <- as.character(melhor.n.pares)
  
  vars.final.fator <- features.grid[[chave.melhor]]
  modelo.final.fator <- modelos.grid[[chave.melhor]]
  
  if (melhor.n.pares == 0) {
    
    pares.final <- tabela.pares[
      0,
      ,
      drop = FALSE
    ]
    
  } else {
    
    pares.final <- head(
      tabela.pares,
      melhor.n.pares
    )
  }
  
  vars.interaction.adicionadas <- setdiff(
    vars.final.fator,
    vars.shap
  )
  
  pares.interaction[[fator]] <- pares.final
  features.interaction[[fator]] <- vars.interaction.adicionadas
  features.final.por.fator[[fator]] <- vars.final.fator
  modelos.finais[[fator]] <- modelo.final.fator
  
  #-------------------------------------------------------------------------
  # 8.7 SALVAR RESULTADOS DO FATOR
  #-------------------------------------------------------------------------
  
  write.csv(
    grid.resultado,
    file.path(
      pasta.tabelas,
      paste0("Grid_SHAP_Interaction_", make.names(fator), ".csv")
    ),
    row.names = FALSE
  )
  
  write.csv(
    pares.final,
    file.path(
      pasta.tabelas,
      paste0(
        "Pares_Interaction_selecionados_",
        make.names(fator),
        ".csv"
      )
    ),
    row.names = FALSE
  )
  
  saveRDS(
    vars.shap,
    file.path(
      pasta.rds,
      paste0("Features_SHAP_principal_", make.names(fator), ".RDS")
    )
  )
  
  saveRDS(
    vars.interaction.adicionadas,
    file.path(
      pasta.rds,
      paste0(
        "Features_Interaction_adicionadas_",
        make.names(fator),
        ".RDS"
      )
    )
  )
  
  saveRDS(
    vars.final.fator,
    file.path(
      pasta.rds,
      paste0("Features_finais_", make.names(fator), ".RDS")
    )
  )
  
  arquivo.modelo.final <- file.path(
    pasta.modelos,
    paste0(
      "CatBoost_SHAP_Interaction_final_",
      make.names(fator),
      ".cbm"
    )
  )
  
  catboost.save_model(
    modelo.final.fator,
    arquivo.modelo.final
  )
  
  avaliacao.selecao <- bind_rows(
    avaliacao.selecao,
    data.frame(
      fator = fator,
      n_features_iniciais = ncol(X),
      n_features_SHAP = length(vars.shap),
      RMSE_modelo_completo = rmse.completo,
      top_pares_interaction = melhor.n.pares,
      n_features_interaction_adicionadas =
        length(vars.interaction.adicionadas),
      n_features_finais = length(vars.final.fator),
      RMSE_valid_final = grid.resultado$RMSE_valid[1],
      stringsAsFactors = FALSE
    )
  )
  
  cat("\nMelhor numero de pares:", melhor.n.pares, "\n")
  cat("Features SHAP:", length(vars.shap), "\n")
  cat(
    "Features recuperadas pela Interaction:",
    length(vars.interaction.adicionadas),
    "\n"
  )
  cat(
    "Numero final de features para",
    fator,
    ":",
    length(vars.final.fator),
    "\n"
  )
  
  print(vars.final.fator)
  
  rm(
    interaction.py,
    X.fit.py,
    explainer.py,
    modelo.py
  )
  
  gc()
}


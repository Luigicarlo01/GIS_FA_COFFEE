get_blue_env <- function(env_i, data) {
  
  df_i <- data[data$env == env_i, ]
  df_i <- droplevels(df_i)
  
  out <- df_i %>%
    dplyr::group_by(gen) %>%
    dplyr::summarise(
      blue = mean(prod, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    dplyr::mutate(env = env_i)
  
  out$blue_dev <- out$blue - mean(
    out$blue,
    na.rm = TRUE
  )
  
  out
}

blue_tab <- do.call(
  rbind,
  lapply(
    rownames(Lambda),
    get_blue_env,
    data = data2
  )
)

n_env <- nrow(CovAmb.shap)

if (n_env < 3) {
  stop("Numero insuficiente de ambientes para validacao.")
}

nmax <- min(
  30,
  n_env - 2,
  ncol(CovAmb.shap)
)

if (nmax < 1) {
  stop("Nenhum numero de componentes PLS pode ser testado.")
}

cv.results <- do.call(
  rbind,
  lapply(
    seq_len(nmax),
    function(j) {
      
      acc_lambda <- numeric(0)
      acc_blue <- numeric(0)
      rmsep_blue <- numeric(0)
      
      for (i in rownames(CovAmb.shap)) {
        
        env_train <- setdiff(
          rownames(CovAmb.shap),
          i
        )
        
        df_train <- data.frame(
          lambda = I(
            Lambda[
              env_train,
              ,
              drop = FALSE
            ]
          ),
          CovAmb = I(
            CovAmb.shap[
              env_train,
              ,
              drop = FALSE
            ]
          )
        )
        
        mod_pls <- pls::plsr(
          lambda ~ CovAmb,
          data = df_train,
          ncomp = j,
          validation = "none"
        )
        
        cf <- coef(
          mod_pls,
          ncomp = j,
          intercept = TRUE
        )[, , 1]
        
        B <- as.matrix(
          cf[
            -1,
            ,
            drop = FALSE
          ]
        )
        
        b0 <- matrix(
          as.numeric(
            cf[1, ]
          ),
          nrow = 1
        )
        
        pred_l <- CovAmb.shap[
          i,
          ,
          drop = FALSE
        ] %*% B + b0
        
        acc.lambda.i <- suppressWarnings(
          cor(
            as.numeric(pred_l),
            as.numeric(Lambda[i, ])
          )
        )
        
        if (is.finite(acc.lambda.i)) {
          acc_lambda <- c(
            acc_lambda,
            acc.lambda.i
          )
        }
        
        pred_e <- as.numeric(
          pred_l %*%
            t(fa4$rot.scores)
        )
        
        names(pred_e) <- rownames(
          fa4$rot.scores
        )
        
        obs_tab <- blue_tab[
          blue_tab$env == i,
          c("gen", "blue_dev")
        ]
        
        common_gen <- intersect(
          names(pred_e),
          as.character(obs_tab$gen)
        )
        
        pred_use <- pred_e[
          common_gen
        ]
        
        obs_use <- obs_tab$blue_dev[
          match(
            common_gen,
            as.character(obs_tab$gen)
          )
        ]
        
        valid <- is.finite(pred_use) &
          is.finite(obs_use)
        
        pred_use <- pred_use[valid]
        obs_use <- obs_use[valid]
        
        if (length(pred_use) >= 3) {
          
          spearman.i <- suppressWarnings(
            cor(
              pred_use,
              obs_use,
              method = "spearman"
            )
          )
          
          if (is.finite(spearman.i)) {
            acc_blue <- c(
              acc_blue,
              spearman.i
            )
          }
          
          rmsep.i <- sqrt(
            mean(
              (pred_use - obs_use)^2,
              na.rm = TRUE
            )
          )
          
          if (is.finite(rmsep.i)) {
            rmsep_blue <- c(
              rmsep_blue,
              rmsep.i
            )
          }
        }
      }
      
      data.frame(
        ncomp = j,
        lambda_cor = mean(
          acc_lambda,
          na.rm = TRUE
        ),
        blue_spearman = mean(
          acc_blue,
          na.rm = TRUE
        ),
        blue_rmsep = mean(
          rmsep_blue,
          na.rm = TRUE
        )
      )
    }
  )
)

